# URL base da API (sem barra final)
# Local:  http://localhost:8000/api
# Docker/produção (mesma origem, nginx faz proxy): /api  (já definido via ARG no Dockerfile)
VITE_API_URL=http://localhost:8000/api

# Google OAuth (Google Identity Services) — mesmo client_id configurado no back-end.
# Em produção ele entra no build pelo docker-compose do back (GOOGLE_CLIENT_ID do .env do back).
# Cadastre a origem https://SEU_DOMINIO em "Origens JavaScript autorizadas" no Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=